#!/usr/bin/env escript
%%! +S 1:1 +SDcpu 1 +SDio 1 -noshell
main(Args) ->
    Root=lists:foldl(fun(_,P) -> filename:dirname(P) end,filename:absname(escript:script_name()),lists:seq(1,4)),
    code:add_paths(filelib:wildcard(filename:join([Root,"builds/intermediates/control/default/lib","*","ebin"]))),
    case code:ensure_loaded(ba_cli) of
        {module,_} -> ba_cli:main(Args,Root);
        _ -> io:format(standard_error,"Build first: bash src/Tools/CLI/build.sh~n",[]),halt(2)
    end.
