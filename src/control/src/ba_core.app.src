{application, ba_core, [
    {description, "BEAM Audio core runtime"},
    {vsn, "0.1.0"},
    {registered, [ba_device_config,ba_buffee_chat,ba_contacts,ba_buffee,ba_sup,ba_buffee_runtime_sup,ba_desk_connections_sup, ba_pg, ba_chat, ba_buffee_clock_sup, ba_buffee_clock,
                  ba_discovery, ba_relay, ba_direct, ba_network, ba_buffees,
                  ba_audio_sup,ba_audio_receiver,ba_audio_mixer,ba_buffee_desks,ba_buffee_membership,ba_buffee_control,ba_device_sup,ba_device_handler,ba_device_worker_sup]},
    {mod, {ba_app, []}},
    {applications, [kernel, stdlib, inets, crypto, gun]},
    {env, [{default_reception_desk_url, <<"wss://buffee-reception.onrender.com/relay/v1">>},
           {direct_stun_urls, [<<"stun:stun.l.google.com:19302">>]}]},
    {licenses, ["Apache-2.0"]}
]}.
