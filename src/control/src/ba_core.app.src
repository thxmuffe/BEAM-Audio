{application, ba_core, [
    {description, "BEAM Audio core runtime"},
    {vsn, "0.1.0"},
    {registered, [ba_permission_pg,ba_sessions,ba_device_config,ba_session_chat,ba_contacts,ba_session,ba_sup,ba_session_runtime_sup,
                  ba_desk_connections_sup,ba_session_clock_sup,ba_session_clock,ba_audio_sup,ba_audio_receiver,ba_session_desks,
                  ba_session_membership,ba_session_control,ba_device_sup,ba_device_handler,ba_device_worker_sup]},
    {mod, {ba_app, []}},
    {applications, [kernel, stdlib, inets, crypto, gun]},
    {env, [{default_reception_desk_url, <<"wss://beamaudio.onrender.com/reception">>},
           {direct_stun_urls, [<<"stun:stun.l.google.com:19302">>]}]},
    {licenses, ["Apache-2.0"]}
]}.
