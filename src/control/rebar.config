{erl_opts, [debug_info, warnings_as_errors]}.
{src_dirs, ["src", "../Audio/src", "../Audio/handlers/legacy", "../Audio/handlers/webrtc", "../Audio/adapters/macOS", "../Audio/adapters/Windows", "../Audio/adapters/iOS"]}.
{deps, [{gun, "2.7.0"}, {cowlib, {git, "https://github.com/ninenines/cowlib", {ref, "4401b858f2229abb3ea115c60924f6c77e5f8aa3"}}}]}.
{base_dir, "../../builds/intermediates/control"}.
{profiles, [{windows, [{deps, [{fs, "11.4.1"}]}]}]}.
{relx, [{release, {parvi, "0.1.0"}, [parvi, compiler]},
        {dev_mode, false}, {include_erts, true}, {include_src, false}]}.
{shell, [{apps, [parvi]}, {config, "config/local.config"}]}.
